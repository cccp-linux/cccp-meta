# .dircolors

COLORTERM ?*
TERM    Eterm
TERM    ansi
TERM    *color*
TERM    con[0-9]*x[0-9]*
TERM    cons25
TERM    console
TERM    cygwin
TERM    *direct*
TERM    dtterm
TERM    gnome
TERM    hurd
TERM    jfbterm
TERM    konsole
TERM    kterm
TERM    linux
TERM    linux-c
TERM    mlterm
TERM    putty
TERM    rxvt*
TERM    screen*
TERM    st
TERM    terminator
TERM    tmux*
TERM    vt100
TERM    vt220
TERM    xterm*

BLK     33;40
CAPABILITY 00
CHR     33;40
DIR     34
DOOR    35
EXEC    32
FIFO    33;40
LINK    36 # target
MISSING 00
MULTIHARDLINK 00
ORPHAN  31;40
OTHER_WRITABLE 34;42
RESET   0
SETGID  30;43
SETUID  37;41
SOCK    35
STICKY  37;44
STICKY_OTHER_WRITABLE 30;42

